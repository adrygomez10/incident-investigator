# Local configuration. Copy to .env and edit that ignored file only.
# Generate separate random values for operator authentication and PostgreSQL.
OPERATOR_TOKEN=
DB_PASSWORD=

# Groq. Create the key in https://console.groq.com/keys
MODEL_BASE_URL=https://api.groq.com/openai/v1
MODEL_NAME=openai/gpt-oss-20b
MODEL_API_KEY=
MODEL_MIN_INTERVAL_SECONDS=65

# Your accessible copy of the orders repository, without https:// or .git.
GITHUB_REPOSITORY=your-github-user/orders-incident-demo
GITHUB_READ_TOKEN=
# Optional: separate Issues write token, used only after exact approval.
GITHUB_WRITE_TOKEN=

# Sentry slugs, regional API URL and user read token. The DSN belongs in orders.
SENTRY_ORGANIZATION=your-sentry-org
SENTRY_PROJECT=orders-incident-demo
SENTRY_REGION=https://sentry.io
SENTRY_ACCESS_TOKEN=

# Keep this logical key for the supplied scripts and HTTP examples.
PROJECT_KEY=orders-demo
# Set both from scripts/export_corpus.py; this path is relative to this project.
CORPUS_PATH=.tools/corpus
CORPUS_REVISION=

# Per-run budgets and shared UTC daily allowance. No paid-provider fallback.
MAX_MODEL_CALLS=8
MAX_TOOL_CALLS=16
MAX_RUN_SECONDS=360
MAX_DAILY_MODEL_ATTEMPTS=200
